# Copy to .env.local. Use absolute paths; forward slashes also work on Windows.
# Directory containing session subdirectories with Power.log (tracking + statistics + archive).
# Example only: change this to your actual Hearthstone Logs directory.
# HEARTHSTONE_LOG_ROOT=C:/Program Files (x86)/Hearthstone/Logs

# Optional explicit file. Takes priority for live tracking; statistics still require LOG_ROOT.
# HEARTHSTONE_POWER_LOG=C:/path/to/session/Power.log

# Optional archive directory. Default: data/power-log-archive inside this project.
# HEARTHSTONE_LOG_ARCHIVE=C:/path/to/private-archive

# Optional settings/deck storage directory. Default: data inside this project.
# TAVERN_DATA_DIR=C:/path/to/private-settings
